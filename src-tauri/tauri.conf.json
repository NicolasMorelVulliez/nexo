{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo",
  "version": "0.3.0",
  "identifier": "com.nexo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Nexo",
    "shortDescription": "Configurador de mouses (Motospeed X6, RAWM)",
    "longDescription": "Nexo configura mouses Motospeed X6 y RAWM (DPI, polling, botones, luz y sensor) y muestra la batería en la barra de tareas.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ],
        "startMenuFolder": ""
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOTIzNTEyQzg2MjE1QUMKUldTc0ZXTElFaldTdms4RDg0aDRVVWVIZ1l5Rk9jb3M4YUxWVUFybUc1TnFDcTZSNjhtZ0V3RCsK",
      "endpoints": [
        "https://github.com/NicolasMorelVulliez/nexo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
